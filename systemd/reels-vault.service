# Copie dans ~/.config/systemd/user/ et adapte les 3 lignes marquées « À ADAPTER ».
[Unit]
Description=Reels Vault : ajouter les nouveaux Reels enregistrés au vault

[Service]
Type=oneshot
# À ADAPTER : dossier du projet
WorkingDirectory=%h/reels-vault
# À ADAPTER : ton pseudo Instagram et le navigateur où tu es connecté
ExecStart=%h/reels-vault/.venv/bin/python mettre_a_jour.py --compte TON_PSEUDO --cookies firefox
# À ADAPTER : le dossier qui contient la commande `claude` doit être dans le PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
StandardOutput=append:%h/reels-vault/mise_a_jour.log
StandardError=append:%h/reels-vault/mise_a_jour.log
